@model IEnumerable<BurguerQueen.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="w-full max-w-4xl mx-auto flex flex-col gap-md">

    <div class="flex items-center justify-between">
        <h1 class="font-headline text-headline-lg text-on-surface m-0">Clientes</h1>
        <a asp-action="Create"
           class="inline-flex items-center justify-center gap-sm bg-primary text-on-primary font-label text-label-lg px-md py-sm rounded border border-primary hover:opacity-90 transition-opacity duration-state-change ease-state-change no-underline">
            <span>Novo cliente</span>
        </a>
    </div>

    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-x-auto">
        <table class="w-full text-left font-body text-body-md">
            <thead class="bg-surface-container-low text-on-surface-variant font-label text-label-md">
                <tr>
                    <th class="px-md py-sm">Nome</th>
                    <th class="px-md py-sm">Telefone</th>
                    <th class="px-md py-sm">CPF</th>
                    <th class="px-md py-sm"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr class="border-t border-outline-variant">
                    <td class="px-md py-sm text-on-surface">@c.Nome</td>
                    <td class="px-md py-sm text-on-surface-variant">@c.Telefone</td>
                    <td class="px-md py-sm text-on-surface-variant">@c.CPF</td>
                    <td class="px-md py-sm text-right">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="text-primary hover:underline">Editar</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="inline"
                              onsubmit="return confirm('Deseja realmente excluir este cliente?');">
                            <button type="submit" class="text-error hover:underline ml-sm">Excluir</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="px-md py-lg text-center text-on-surface-variant">Nenhum cliente cadastrado.</td></tr>
            }
            </tbody>
        </table>
    </section>

</div>