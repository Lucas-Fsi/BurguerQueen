@model IEnumerable<BurguerQueen.Models.ViewModels.PedidoListaViewModel>
@using BurguerQueen.Models.Enums
@{
    ViewData["Title"] = "Pedidos";
    var filtro = (StatusPedido?)ViewBag.StatusSelecionado;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Pedidos</h2>
    <a asp-action="Create" class="btn btn-primary">Novo pedido</a>
</div>

<form method="get" class="mb-3">
    <select name="status" class="form-select w-auto" onchange="this.form.submit()">
        <option value="">Todos os status</option>
        @foreach (StatusPedido s in Enum.GetValues(typeof(StatusPedido)))
        {
            <option value="@((int)s)" selected="@(filtro == s)">@s.Texto()</option>
        }
    </select>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Data</th>
                <th>Status</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.NomeCliente</td>
                <td>@p.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                <td><span class="badge @p.Status.BadgeClass()">@p.Status.Texto()</span></td>
                <td class="text-end">@p.Total.ToString("C")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">Nenhum pedido encontrado.</td></tr>
        }
        </tbody>
    </table>
</div>