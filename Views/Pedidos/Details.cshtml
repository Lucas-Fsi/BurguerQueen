@model BurguerQueen.Models.ViewModels.PedidoDetalhesViewModel
@using BurguerQueen.Models.Enums
@{ ViewData["Title"] = $"Pedido #{Model.Id}"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Pedido #@Model.Id</h2>
    <span class="badge fs-6 @Model.Status.BadgeClass()">@Model.Status.Texto()</span>
</div>

<div class="card mb-4">
    <div class="card-body">
        <p class="mb-1"><strong>Cliente:</strong> @Model.NomeCliente</p>
        <p class="mb-1"><strong>Data:</strong> @Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")</p>
        <p class="mb-0 fs-5"><strong>Total:</strong> @Model.Total.ToString("C")</p>
    </div>
</div>

@if (Model.PodeEditarItens)
{
    <form asp-action="AdicionarItem" asp-route-id="@Model.Id" method="post" class="row g-2 mb-4">
        <div class="col-md-6">
            <select name="produtoId" asp-items="Model.Produtos" class="form-select" required>
                <option value="">Selecione o produto</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="number" name="quantidade" value="1" min="1" class="form-control" required />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-success">Adicionar item</button>
        </div>
    </form>
}

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Produto</th>
                <th class="text-center">Qtd</th>
                <th class="text-end">Preço unit.</th>
                <th class="text-end">Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Itens)
        {
            <tr>
                <td>@item.NomeProduto</td>
                <td class="text-center">@item.Quantidade</td>
                <td class="text-end">@item.PrecoUnitario.ToString("C")</td>
                <td class="text-end">@item.Subtotal.ToString("C")</td>
                <td class="text-end">
                    @if (Model.PodeEditarItens)
                    {
                        <form asp-action="RemoverItem" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (!Model.Itens.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">Nenhum item adicionado ainda.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Pagamentos.Any())
{
    <h4 class="mt-4">Pagamentos</h4>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Resumo</th>
                    <th class="text-end">Valor</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var pag in Model.Pagamentos)
            {
                <tr>
                    <td>@pag.Descricao</td>
                    <td class="text-end">@pag.Valor.ToString("C")</td>
                    <td><span class="badge @pag.Status.BadgeClass()">@pag.Status.Texto()</span></td>
                    <td class="text-end">
                        <a asp-controller="Pagamentos" asp-action="Details" asp-route-id="@pag.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="d-flex gap-2 mt-3">
    @if (Model.AguardandoPagamento)
    {
        <span class="text-muted align-self-center">Registre o pagamento para avançar o pedido.</span>
    }
    @if (Model.PodeAvancar)
    {
        <form asp-action="AvancarStatus" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-primary">@Model.TextoAvancar</button>
        </form>
    }
    @if (Model.PodePagar)
    {
        <a asp-controller="Pagamentos" asp-action="Create" asp-route-pedidoId="@Model.Id" class="btn btn-success">Pagar</a>
    }
    @if (Model.PodeCancelar)
    {
        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Deseja realmente cancelar este pedido?');">
            <button type="submit" class="btn btn-outline-danger">Cancelar pedido</button>
        </form>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>