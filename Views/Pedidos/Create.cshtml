@{ ViewData["Title"] = "Novo pedido"; }

<h2>Novo pedido</h2>
<p class="text-muted">O pedido será aberto no balcão. Depois você adiciona os itens.</p>

<form asp-action="CriarPedido" method="post">
    <button type="submit" class="btn btn-primary">Abrir pedido</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>