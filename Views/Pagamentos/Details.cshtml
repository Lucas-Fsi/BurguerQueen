@using BurguerQueen.Models.Enums
@model BurguerQueen.Models.ViewModels.PagamentoDetalhesViewModel
@{
    ViewData["Title"] = $"Pagamento #{Model.Id}";

    string PagamentoBadgeClasses(StatusPagamento s) => s switch
    {
        StatusPagamento.Aprovado => "bg-success-container text-on-success-container",
        StatusPagamento.Pendente => "bg-secondary-container text-on-secondary-container",
        StatusPagamento.Estornado => "bg-error-container text-on-error-container",
        StatusPagamento.Cancelado => "bg-surface-container text-on-surface-variant",
        _ => "bg-surface-container text-on-surface"
    };
}

<div class="w-full max-w-2xl mx-auto flex flex-col gap-md">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-xs text-on-surface-variant">
        <a asp-controller="Pedidos" asp-action="Index"
           class="font-label text-label-md text-on-surface-variant hover:text-primary transition-colors duration-state-change ease-state-change no-underline">
            <span>Pedidos</span>
        </a>
        <span class="material-symbols-outlined text-body-md text-outline" aria-hidden="true">chevron_right</span>
        <a asp-controller="Pedidos" asp-action="Details" asp-route-id="@Model.PedidoId"
           class="font-label text-label-md text-on-surface-variant hover:text-primary transition-colors duration-state-change ease-state-change no-underline">
            <span>Pedido #@Model.PedidoId</span>
        </a>
        <span class="material-symbols-outlined text-body-md text-outline" aria-hidden="true">chevron_right</span>
        <span class="font-label text-label-md text-on-surface">Pagamento #@Model.Id</span>
    </nav>

    <section class="bg-surface-container-lowest border border-outline-variant rounded-lg overflow-hidden">
        <!-- Header -->
        <div class="px-lg pt-lg pb-md border-b border-outline-variant flex items-start justify-between gap-md">
            <div class="flex flex-col gap-xs">
                <div class="flex items-center gap-sm">
                    <h1 class="font-headline text-headline-lg text-on-surface tabular-nums m-0">Pagamento #@Model.Id</h1>
                    <span role="status" class="inline-flex items-center px-sm py-xs rounded-full font-label text-label-md @PagamentoBadgeClasses(Model.Status)">
                        <span>@Model.Status.Texto()</span>
                    </span>
                </div>
                <p class="font-body text-body-sm text-on-surface-variant tabular-nums m-0">
                    Pedido #@Model.PedidoId • @Model.DataHora.ToString("dd/MM/yyyy 'às' HH:mm")
                </p>
            </div>

            <div class="text-right shrink-0">
                <span class="font-body text-body-sm text-on-surface-variant block">Valor</span>
                <span class="font-headline text-headline-md text-on-surface tabular-nums">@Model.Valor.ToString("C")</span>
            </div>
        </div>

        <!-- Body -->
        <div class="p-lg flex flex-col gap-md">
            <div class="bg-surface-container-low border border-outline-variant rounded-md p-md flex flex-col gap-xs">
                <span class="font-label text-label-md text-on-surface-variant uppercase tracking-wider">Resumo da operação</span>
                <p class="font-body text-body-lg text-on-surface m-0">@Model.Descricao</p>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="px-lg py-md bg-surface-container-low border-t border-outline-variant flex flex-wrap items-center justify-between gap-sm">
            <a asp-controller="Pedidos" asp-action="Details" asp-route-id="@Model.PedidoId"
               class="inline-flex items-center justify-center gap-xs bg-surface-container-lowest text-on-surface font-label text-label-lg px-md py-sm rounded border border-outline-variant hover:bg-surface-container transition-colors duration-state-change ease-state-change no-underline">
                <span class="material-symbols-outlined text-title-md" aria-hidden="true">arrow_back</span>
                <span>Voltar ao pedido</span>
            </a>

            <div class="flex flex-wrap items-center gap-sm">
                @if (Model.PodeConfirmar)
                {
                    <form asp-action="Confirmar" asp-route-id="@Model.Id" method="post">
                        <button type="submit"
                                class="inline-flex items-center justify-center gap-xs bg-success text-on-success font-label text-label-lg px-md py-sm rounded border border-success hover:opacity-90 transition-opacity duration-state-change ease-state-change">
                            <span class="material-symbols-outlined text-title-md" aria-hidden="true">check</span>
                            <span>Confirmar</span>
                        </button>
                    </form>
                }
                @if (Model.PodeCancelar)
                {
                    <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post">
                        <button type="submit"
                                class="inline-flex items-center justify-center gap-xs bg-surface-container-lowest text-on-surface font-label text-label-lg px-md py-sm rounded border border-outline-variant hover:bg-surface-container transition-colors duration-state-change ease-state-change">
                            <span>Cancelar pagamento</span>
                        </button>
                    </form>
                }
                @if (Model.PodeEstornar)
                {
                    <form asp-action="Estornar" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Deseja estornar este pagamento?');">
                        <button type="submit"
                                class="inline-flex items-center justify-center gap-xs bg-error text-on-error font-label text-label-lg px-md py-sm rounded border border-error hover:opacity-90 transition-opacity duration-state-change ease-state-change">
                            <span class="material-symbols-outlined text-title-md" aria-hidden="true">undo</span>
                            <span>Estornar</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </section>

</div>
